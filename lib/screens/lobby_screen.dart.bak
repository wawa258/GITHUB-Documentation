import 'package:flutter/material.dart';
import 'package:flutter_svg/flutter_svg.dart';
import 'package:google_fonts/google_fonts.dart';

import '../create_player_screen.dart';
import 'game_screen.dart';

class LobbyScreen extends StatelessWidget {
  const LobbyScreen({
    super.key,
    required this.player,
    required this.onSignOut,
  });

  final PlayerConfig player;
  final VoidCallback onSignOut;

  void _openGame(BuildContext context) {
    Navigator.of(context).push(
      MaterialPageRoute(builder: (_) => GameScreen(player: player)),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF24145C),
      body: Stack(
        fit: StackFit.expand,
        children: [
          SvgPicture.asset(
            'assets/images/codenect-main-lobby.svg',
            fit: BoxFit.cover,
          ),
          SafeArea(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    player.name.toUpperCase(),
                    style: GoogleFonts.pressStart2p(
                      fontSize: 12,
                      color: const Color(0xFFFFC933),
                    ),
                  ),
                  TextButton(
                    onPressed: onSignOut,
                    child: Text(
                      'SIGN OUT',
                      style: GoogleFonts.pressStart2p(
                        fontSize: 10,
                        color: const Color(0xFFFFC933),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
          SafeArea(
            child: Align(
              alignment: Alignment.bottomCenter,
              child: Padding(
                padding: const EdgeInsets.only(bottom: 16, left: 16, right: 16),
                child: LayoutBuilder(
                  builder: (context, constraints) {
                    final w =
                        ((constraints.maxWidth - 24) / 2).clamp(180.0, 360.0);
                    final scale = w / 360;
                    return Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        PixelButton(
                          label: 'START ADVENTURE',
                          width: w,
                          height: 68 * scale,
                          fontSize: 16 * scale,
                          onPressed: () => _openGame(context),
                        ),
                        const SizedBox(width: 24),
                        PixelButton(
                          label: 'CONTINUE ADVENTURE',
                          width: w,
                          height: 68 * scale,
                          fontSize: 15 * scale,
                          onPressed: () => _openGame(context),
                        ),
                      ],
                    );
                  },
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class PixelButton extends StatefulWidget {
  const PixelButton({
    super.key,
    required this.label,
    required this.onPressed,
    this.width = 360,
    this.height = 68,
    this.fontSize = 16,
  });

  final String label;
  final VoidCallback onPressed;
  final double width;
  final double height;
  final double fontSize;

  @override
  State<PixelButton> createState() => _PixelButtonState();
}

class _PixelButtonState extends State<PixelButton> {
  bool _pressed = false;

  static const _outline = Color(0xFF0D0620);
  static const _face = Color(0xFFFFC933);
  static const _highlight = Color(0xFFFFF0A8);
  static const _shadow = Color(0xFFD98E04);
  static const _text = Color(0xFF2A1608);

  @override
  Widget build(BuildContext context) {
    final offset = _pressed ? 6.0 : 0.0;

    return GestureDetector(
      onTapDown: (_) => setState(() => _pressed = true),
      onTapUp: (_) => setState(() => _pressed = false),
      onTapCancel: () => setState(() => _pressed = false),
      onTap: widget.onPressed,
      child: SizedBox(
        width: widget.width,
        height: widget.height + 12,
        child: Stack(
          children: [
            Positioned(
              left: 0,
              right: 0,
              top: 12,
              height: widget.height,
              child: const ColoredBox(color: _outline),
            ),
            AnimatedPositioned(
              duration: const Duration(milliseconds: 60),
              left: 0,
              right: 0,
              top: offset,
              height: widget.height,
              child: Container(
                color: _outline,
                padding: const EdgeInsets.all(4),
                child: Stack(
                  children: [
                    const Positioned.fill(child: ColoredBox(color: _face)),
                    const Positioned(
                      left: 0,
                      right: 0,
                      top: 0,
                      height: 5,
                      child: ColoredBox(color: _highlight),
                    ),
                    const Positioned(
                      left: 0,
                      right: 0,
                      bottom: 0,
                      height: 7,
                      child: ColoredBox(color: _shadow),
                    ),
                    Center(
                      child: Padding(
                        padding: const EdgeInsets.only(bottom: 4),
                        child: Text(
                          widget.label,
                          style: GoogleFonts.pressStart2p(
                            fontSize: widget.fontSize,
                            color: _text,
                            letterSpacing: 1,
                          ),
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
